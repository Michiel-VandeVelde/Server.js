# Compiled TypeScript output (compiled in-place next to .ts sources).
#
# Declaration files (*.d.ts) and source maps (*.js.map) are always generated
# build output — no package ever hand-writes one — so these two patterns are
# safe to ignore repo-wide from the very first layer of this staged migration.
# Compiled *.js is different: in a package that hasn't converted yet, *.js IS
# the real hand-written source, so it must only be ignored once that specific
# package has actually converted. Those per-package *.js patterns are appended
# below as each package converts, rather than blanket-ignored here.
packages/*/lib/**/*.d.ts
packages/*/lib/**/*.js.map
packages/*/index.d.ts
packages/*/index.js.map
packages/*/bin/*.d.ts
packages/*/bin/*.js.map
packages/core/lib/**/*.js
packages/core/index.js
packages/core/bin/*.js
packages/datasource-composite/lib/**/*.js
packages/datasource-composite/index.js
packages/datasource-composite/bin/*.js
packages/datasource-hdt/lib/**/*.js
packages/datasource-hdt/index.js
packages/datasource-hdt/bin/*.js
packages/datasource-jsonld/lib/**/*.js
packages/datasource-jsonld/index.js
packages/datasource-jsonld/bin/*.js
packages/datasource-n3/lib/**/*.js
packages/datasource-n3/index.js
packages/datasource-n3/bin/*.js
packages/datasource-rdfa/lib/**/*.js
packages/datasource-rdfa/index.js
packages/datasource-rdfa/bin/*.js
packages/datasource-sparql/lib/**/*.js
packages/datasource-sparql/index.js
packages/datasource-sparql/bin/*.js
packages/feature-memento/lib/**/*.js
packages/feature-memento/index.js
packages/feature-memento/bin/*.js
packages/feature-qpf/lib/**/*.js
packages/feature-qpf/index.js
packages/feature-qpf/bin/*.js
packages/feature-summary/lib/**/*.js
packages/feature-summary/index.js
packages/feature-summary/bin/*.js
packages/feature-webid/lib/**/*.js
packages/feature-webid/index.js
packages/feature-webid/bin/*.js
packages/preset-qpf/lib/**/*.js
packages/preset-qpf/index.js
packages/preset-qpf/bin/*.js
