# Compiled TypeScript output (compiled in-place next to .ts sources).
# Added per-package as each one converts to TypeScript in this staged migration —
# a blanket "packages/*/lib/**/*.js is compiled output" pattern would silently
# ignore genuine hand-written .js source in packages that haven't converted yet.

# Ignore deployment configuration files, but keep defaults and examples
config.json
config/*.json
!config/config-defaults.json
!config/config-example*.json

# Ignore dev environment files
.idea
.devcontainer
.copier-answers.yml