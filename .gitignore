node_modules
data
summaries
*.log
*.hdt.index*
.nyc_output
coverage

# Compiled TypeScript output (compiled in-place next to .ts sources).
#
# Declaration files (*.d.ts) and source maps (*.js.map) are always generated
# build output — no package ever hand-writes one — so these two patterns are
# safe to ignore repo-wide from the very first layer of this staged migration.
packages/*/lib/**/*.d.ts
packages/*/lib/**/*.js.map
packages/*/index.d.ts
packages/*/index.js.map
packages/*/bin/*.d.ts
packages/*/bin/*.js.map

# Compiled *.js is different: in a package that hasn't converted yet, *.js IS
# the real hand-written source, so a blanket pattern here would silently
# ignore genuine hand-written .js source in packages that haven't converted yet.
# Instead, each package's own compiled-*.js patterns are appended below via
# scripts/add-converted-package-ignores.sh once that package actually converts.
packages/core/lib/**/*.js
packages/core/index.js
packages/core/bin/*.js

# Ignore deployment configuration files, but keep defaults and examples
config.json
config/*.json
!config/config-defaults.json
!config/config-example*.json

# Ignore dev environment files
.idea
.devcontainer
.copier-answers.yml