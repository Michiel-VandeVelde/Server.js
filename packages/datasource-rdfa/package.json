{
  "name": "@ldf/datasource-rdfa",
  "description": "Linked Data Fragments Server - RDFa Datasource",
  "version": "3.3.0",
  "lsd:module": true,
  "license": "MIT",
  "main": "index.js",
  "types": "index",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "index.js",
    "index.d.ts"
  ],
  "repository": "https://github.com/LinkedDataFragments/Server.js/tree/master/packages/datasource-rdfa",
  "bugs": {
    "url": "https://github.com/LinkedDataFragments/Server.js/issues"
  },
  "scripts": {
    "test": "TS_NODE_PROJECT=../../tsconfig.test.json TS_NODE_PREFER_TS_EXTS=true nyc mocha --require ../../test/test-setup.ts --recursive --timeout 500 \"test/**/*-test.ts\" \"test/**/*-test.js\"",
    "lint": "eslint bin/* lib test",
    "build": "test -f ../../node_modules/typescript/bin/tsc && node ../../node_modules/typescript/bin/tsc || echo '[build] typescript not found outside the monorepo, skipping (assuming already built)'",
    "prepare": "npm run build"
  },
  "dependencies": {
    "rdf-string": "^1.3.1",
    "rdfa-streaming-parser": "^1.5.0"
  },
  "peerDependencies": {
    "@ldf/core": "^3.0.0"
  },
  "devDependencies": {
    "@ldf/core": "^3.2.1"
  },
  "engines": {
    "node": ">=18.0"
  }
}
